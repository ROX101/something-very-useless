# Local development defaults. On Railway set these in the service's Variables tab.

# Postgres connection. On Railway use a reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://apaar:apaar@localhost:5432/apaar_sathi

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me

# Encrypts the universities' private signing keys (AES-256-GCM). Required in production; keep it stable.
SIGNING_KEY_SECRET=change-me-too

# Public https URL of the site, used in certificate QR links and the revocation status-list URL
PUBLIC_URL=http://localhost:5173

# true: show the consent one-time password on screen (no SMS gateway in this build). Set false with a real SMS provider.
OTP_DEMO=true

# Session length in hours (default 8)
SESSION_HOURS=8

# Load the demo accounts and data on first boot when the database is empty (default true)
SEED_ON_BOOT=true

# Set to true only when connecting to Postgres over its public URL with TLS (not needed on Railway's private network)
DATABASE_SSL=false

# Port the API listens on. Railway sets this automatically.
PORT=8080
